const int analogPin = 15; // Pino GPIO 34 (ADC1_CH6)
float conversionFactor = 3.483 / 4095.0; // Conversão básica ADC do ESP32
float voltageMax = 4;
// Ajuste este valor com base na leitura real medida com um multímetro
float resistorRatio = (217.0 + 203.0) / 203.0; 

void setup() {
  Serial.begin(115200);
  pinMode(15, INPUT);

  Wire.begin(21,22);

  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("Erro: SSD1306 allocation failed (Verifique pinos e endereco)"));
  for(;;); // Se falhar, o código para aqui
  }
  analogSetAttenuation(ADC_11db); // Configura a atenuação para leitura até ~3.3V
}

void playGIF() {

  int rawValue = analogRead(analogPin);

  float voltage = rawValue * conversionFactor * resistorRatio;

  float percent = voltage  * 100 / voltageMax;

  Serial.println(percent);

  int index = percent * 7 / 100;

  for (uint8_t frame = 0; frame <= index; frame++) {
    // Hiển thị khung hình hiện tại
    for (uint16_t y = 0; y < ICONS8_BATTERY_LEVEL_HEIGHT; y++) {
      for (uint16_t x = 0; x < ICONS8_BATTERY_LEVEL_WIDTH; x++) {
        uint16_t byteIndex = (y / 8) * ICONS8_BATTERY_LEVEL_WIDTH + x;
        uint8_t bitIndex = y % 8;
        if (icons8_battery_level[index][byteIndex] & (1 << bitIndex)) {
          display.drawPixel(x, y, WHITE);
        }
      }
    }
    display.display();
    delay(icons8_battery_level_delays[frame]);
  }
}

void loop() {
  display.clearDisplay();

  playGIF();

  delay(3000);
}